generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id            String       @id @default(cuid())
  name          String
  email         String       @unique
  password      String       @default("")
  role          String       @default("user") // "user" or "admin"
  plan          String       @default("free")
  creditsUsed   Int          @default(0)
  creditsLimit  Int          @default(3)
  subscription  Subscription?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  transactions  CreditTransaction[]
  videos        GeneratedVideo[]
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires      DateTime
}

model Subscription {
  id              String   @id @default(cuid())
  userId          String   @unique
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan            String
  status          String   @default("active")
  stripeSessionId String?
  startDate       DateTime @default(now())
  endDate         DateTime?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model CreditTransaction {
  id          String   @id @default(cuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  amount      Int      // positive = credit added, negative = credit used
  type        String   // "video_generation", "admin_grant", "admin_revoke", "plan_upgrade", "plan_reset", "refund"
  description String   // human-readable reason
  jobId       String?  // related job ID (for video generations)
  metadata    String?  // JSON string for extra context
  createdAt   DateTime @default(now())
}

model AdminSettings {
  id                       String   @id @default("main")
  siteName                 String   @default("AI Avatar Machine")
  stripePublicKey          String?
  stripeSecretKey          String?
  stripeWebhookSecret      String?
  planFreeCredits          Int      @default(3)
  planProCredits           Int      @default(50)
  planEnterpriseCredits    Int      @default(999999)
  planFreePrice            String   @default("0")
  planProPrice             String   @default("19.99")
  planEnterprisePrice      String   @default("49.99")
  creditCostPerScene       Int      @default(1) // how many credits per video scene
  enableRegistration       Boolean  @default(true)
  enableStripePayment      Boolean  @default(false)
  createdAt                DateTime @default(now())
  updatedAt                DateTime @updatedAt
}

model GeneratedVideo {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String   @default("My AI Video")
  videoUrl     String
  captionUrl   String?  // URL of the captioned version of the video (if captions were added)
  thumbnailUrl String?
  duration     String?
  scenesCount  Int      @default(1)
  provider     String   @default("kie")
  metadata     String?  // JSON string for extra data (e.g. carousel image URLs)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}


// ─── Auto-Publish Machine (Blotato API) ─────────────────────────────────────
// Added by AutoPublish Machine integration

model TikTokAccount {
  id           String   @id @default(cuid())
  blotatoId    String   @unique
  username     String?
  displayName  String?
  platform     String   @default("tiktok")
  avatarUrl    String?
  isActive     Boolean  @default(true)
  lastSyncedAt DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  posts        Post[]
}

model Post {
  id              String        @id @default(cuid())
  accountId       String
  account         TikTokAccount @relation(fields: [accountId], references: [id], onDelete: Cascade)

  source          String        @default("manual")
  externalId      String?

  videoUrl        String
  thumbnailUrl    String?
  caption         String?
  hashtags        String?
  musicTitle      String?
  aiDescription   String?

  status          String        @default("PENDING")
  scheduledAt     DateTime?
  publishedAt     DateTime?
  blotatoPostId   String?

  views           Int           @default(0)
  likes           Int           @default(0)
  comments        Int           @default(0)
  shares          Int           @default(0)
  tiktokUrl       String?

  errorMessage    String?
  retryCount      Int           @default(0)

  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  logs            PostLog[]
  analytics       Analytics[]
}

model PostLog {
  id        String   @id @default(cuid())
  postId    String
  level     String
  message   String
  createdAt DateTime @default(now())
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model Analytics {
  id         String   @id @default(cuid())
  postId     String
  views      Int
  likes      Int
  comments   Int
  shares     Int
  recordedAt DateTime @default(now())
  post       Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
}


// ─── Bot Tasks (AI-powered automation) ──────────────────────────────────────
model BotTask {
  id           String   @id @default(cuid())
  userId       String?  // optional: link to user
  
  // Command info
  command      String   // original natural language command
  parsedAction String   // AI-parsed action type: "publish_now", "schedule", "bulk_publish", "auto_publish_new"
  parsedData   String?  // JSON string with parsed parameters
  
  // Execution
  status       String   @default("pending") // pending, in_progress, completed, failed, cancelled
  result       String?  // JSON string with execution result
  errorMessage String?
  
  // For recurring automations
  isRecurring  Boolean  @default(false)
  cronSchedule String?  // for recurring tasks
  lastRunAt    DateTime?
  nextRunAt    DateTime?
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}


// ─── Google Drive Imports ───────────────────────────────────────────────────
model GoogleDriveImport {
  id           String   @id @default(cuid())
  folderUrl    String   // Google Drive folder URL
  folderId     String?  // Extracted folder ID
  
  // Import status
  status       String   @default("pending") // pending, importing, completed, failed
  totalFiles   Int      @default(0)
  importedFiles Int     @default(0)
  publishedFiles Int    @default(0)
  
  // Settings
  autoPublish  Boolean  @default(false)
  publishMode  String   @default("now") // now, schedule, bulk
  
  // Result
  errorMessage String?
  importedVideoIds String? // JSON array of GeneratedVideo IDs
  
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}


// ─── Schedule Machine (Blotato API v2 — Bearer auth) ───────────────────────
// A dedicated, more advanced scheduling system built on the newer Blotato API.
// Coexists with AutoPublishMachine — does NOT modify existing Post/BotTask data.

model SchedulePlan {
  id           String   @id @default(cuid())
  userId       String?  // optional: link to user

  // Plan metadata
  name         String   // e.g. "Summer content calendar"
  description  String?

  // Plan window
  startDate    DateTime
  endDate      DateTime?

  // Plan settings (JSON): { postsPerDay, timeSlots, accountIds, videoSelectionMode }
  settings     String?

  // Status: draft, active, paused, completed, archived
  status       String   @default("draft")

  // Stats
  totalSlots   Int      @default(0)
  filledSlots  Int      @default(0)
  publishedSlots Int    @default(0)

  // Relations
  slots        ScheduleSlot[]
  rules        ScheduleRule[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ScheduleSlot {
  id           String   @id @default(cuid())
  planId       String?
  plan         SchedulePlan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  // Account association (via Blotato account id — stored as string for flexibility)
  accountId    String   // blotato account id
  accountLabel String?  // cached username/displayName for display

  // Slot time
  scheduledAt  DateTime

  // Content to publish
  videoUrl     String?
  thumbnailUrl String?
  imageUrls    String?  // JSON array for carousel posts
  caption      String?
  hashtags     String?  // JSON array
  musicTitle   String?
  aiDescription String?

  // Source of the content
  sourceVideoId String? // GeneratedVideo id (if pulled from library)
  source        String   @default("manual") // manual, library, bot, autopilot, rule

  // Blotato post linkage
  blotatoPostId String?
  blotatoStatus String?  // pending, publishing, published, failed, scheduled

  // Slot status
  // - "open":      empty slot waiting to be filled
  // - "scheduled": content assigned + sent to Blotato (will publish at scheduledAt)
  // - "published": successfully published
  // - "failed":    publish failed
  // - "cancelled": user cancelled
  status       String   @default("open")

  errorMessage String?
  tiktokUrl    String?

  // Analytics (filled after publish)
  views        Int      @default(0)
  likes        Int      @default(0)
  comments     Int      @default(0)
  shares       Int      @default(0)

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Linked recurring rule (if generated by a rule)
  ruleId       String?
  rule         ScheduleRule? @relation(fields: [ruleId], references: [id], onDelete: SetNull)

  @@index([scheduledAt])
  @@index([accountId])
  @@index([status])
  @@index([planId])
}

model ScheduleRule {
  id           String   @id @default(cuid())
  planId       String?
  plan         SchedulePlan? @relation(fields: [planId], references: [id], onDelete: Cascade)

  // Recurrence pattern
  // - "daily":    every N days at HH:MM
  // - "weekly":   on specific weekdays at HH:MM
  // - "monthly":  on day-of-month at HH:MM
  // - "interval": every N hours
  frequency    String   // daily, weekly, monthly, interval
  interval     Int      @default(1) // every N days/hours
  weekdays     String?  // JSON array of weekday numbers (0=Sun .. 6=Sat) for weekly
  dayOfMonth   Int?     // for monthly
  timeOfDay    String?  // "HH:MM" for daily/weekly/monthly
  timezone     String   @default("UTC")

  // What to publish
  accountIds   String   // JSON array of Blotato account ids
  videoSelectionMode String @default("library_recent") // library_recent, library_random, library_top, ai_generate
  caption      String?
  hashtags     String?  // JSON array

  // Active window
  startDate    DateTime
  endDate      DateTime?
  isActive     Boolean  @default(true)

  // Execution tracking
  lastRunAt    DateTime?
  nextRunAt    DateTime?
  slotsCreated Int      @default(0)

  slots        ScheduleSlot[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([nextRunAt])
  @@index([isActive])
}

model ScheduleConversation {
  id           String   @id @default(cuid())
  userId       String?  // optional: link to user
  title        String   @default("New conversation")
  summary      String?  // AI-generated short summary

  // Stats
  messageCount Int      @default(0)
  actionsTaken Int      @default(0) // number of bot actions executed

  messages     ScheduleMessage[]

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model ScheduleMessage {
  id              String   @id @default(cuid())
  conversationId  String
  conversation    ScheduleConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  // "user" | "assistant" | "system"
  role            String
  content         String

  // For assistant messages: structured action metadata (JSON)
  // { action, slotsCreated, slotsModified, plan, ... }
  metadata        String?

  createdAt       DateTime @default(now())

  @@index([conversationId])
}

// ─── WENOV8 marketing site — contact form submissions ──────────────────────

model ContactMessage {
  id          String   @id @default(cuid())
  name        String
  email       String
  company     String?
  website     String?
  projectType String
  budgetRange String?
  details     String
  createdAt   DateTime @default(now())

  @@index([createdAt])
}
